{
  "manifest_version": 3,
  "name": "__MSG_nom__",
  "description": "__MSG_description__",
  "version": "1.5.0",
  "default_locale": "fr",
  "key": "",
  "icons": {
    "16": "icones/secretlin-16.png",
    "32": "icones/secretlin-32.png",
    "48": "icones/secretlin-48.png",
    "128": "icones/secretlin-128.png"
  },
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SecretLin",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/secretlin-16.png",
      "32": "icones/secretlin-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "secretlin@peterpan1-sudo.github.io",
      "strict_min_version": "128.0"
    }
  }
}
