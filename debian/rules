#!/usr/bin/make -f

APP = debian/secretlin/usr/share/secretlin

%:
	dh $@

override_dh_auto_build:
	python3 -m gestionnaire.logo debian/secretlin-256.png 256
	python3 -m gestionnaire.logo debian/secretlin-48.png 48

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	python3 -m pytest -q -p no:cacheprovider tests
endif

override_dh_auto_install:
	install -D -m 644 lancer.py $(APP)/lancer.py
	install -d $(APP)/gestionnaire
	install -m 644 gestionnaire/*.py gestionnaire/logos.zip gestionnaire/traductions.json $(APP)/gestionnaire/
	install -m 644 navigateur.py $(APP)/navigateur.py
	install -m 755 debian/secretlin-navigateur.sh $(APP)/secretlin-navigateur
	cp -r extension $(APP)/extension
	find $(APP)/extension -type d -exec chmod 755 {} +
	find $(APP)/extension -type f -exec chmod 644 {} +
	install -D -m 644 debian/hote-firefox.json debian/secretlin/usr/lib/mozilla/native-messaging-hosts/fr.secretlin.navigateur.json
	install -D -m 644 debian/hote-chromium.json debian/secretlin/etc/chromium/native-messaging-hosts/fr.secretlin.navigateur.json
	install -D -m 644 debian/hote-chromium.json debian/secretlin/etc/opt/chrome/native-messaging-hosts/fr.secretlin.navigateur.json
	install -D -m 644 debian/hote-chromium.json debian/secretlin/etc/opt/edge/native-messaging-hosts/fr.secretlin.navigateur.json
	install -D -m 755 debian/secretlin.sh debian/secretlin/usr/bin/secretlin
	install -D -m 644 debian/secretlin.desktop debian/secretlin/usr/share/applications/secretlin.desktop
	install -D -m 644 debian/secretlin-256.png debian/secretlin/usr/share/icons/hicolor/256x256/apps/secretlin.png
	install -D -m 644 debian/secretlin-48.png debian/secretlin/usr/share/icons/hicolor/48x48/apps/secretlin.png

override_dh_python3:
	dh_python3 /usr/share/secretlin

execute_after_dh_clean:
	rm -f debian/secretlin-256.png debian/secretlin-48.png
